# Loaded by `bun test`, for every process a test starts (ADR 0109): the
# tests' programs are rust-js's own, which use rustc's unstable features,
# natively too, which a stable release lets a crate use only with this. A
# test of the refusal unsets it.
RUSTC_BOOTSTRAP=1
# Every tree the compiler prints checked first, `js::validate`, in a release
# build too, as the nightly's suites run one (#1681, ADR 1143).
RUST_JS_VALIDATE=1
